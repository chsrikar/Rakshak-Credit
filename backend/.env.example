# Luna handles both extraction and reviewer explanations in the MVP demo.
LUNA_API_URL=https://api.openai.com/v1/chat/completions
LUNA_MODEL_NAME=gpt-6-luna
LUNA_API_KEY=
LUNA_TIMEOUT_SECONDS=30

# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Required for local encrypted applicant/document storage. Keep this stable and secret.
DOCUMENT_ENCRYPTION_KEY=

# Local demo-only role accounts. Change these before any shared deployment.
AUTH_SECRET_KEY=
AUTH_TOKEN_TTL_SECONDS=28800
DEMO_BORROWER_USERNAME=borrower.demo
DEMO_BORROWER_PASSWORD=
DEMO_LENDER_USERNAME=lender.demo
DEMO_LENDER_PASSWORD=
